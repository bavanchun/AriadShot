#
# Refuses pushes to main or master (changes reach main only through a pull request) and scans every pushed commit
# for secrets. Git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.

set -uo pipefail
remote=$1
readonly ZERO=0000000000000000000000000000000000000000

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-push: gitleaks is not installed, so the pushed commits cannot be scanned for secrets (see scripts/setup-dev.sh)"
    exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main | refs/heads/master)
            echo "pre-push: refusing to push $local_ref to $remote_ref; open a pull request instead"
            exit 1
            ;;
    esac
    # Deleting a remote ref pushes no commits.
    [ "${local_sha//0/}" = "" ] && continue
    if [ "$remote_sha" = "$ZERO" ] || [ "${remote_sha//0/}" = "" ]; then
        log_range="$local_sha --not --remotes=$remote"
    else
        log_range="$remote_sha..$local_sha"
    fi
    gitleaks git --no-banner --redact --log-opts="$log_range" . || status=1
done
exit "$status"
