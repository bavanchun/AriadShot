#
# Formatting of staged C/C++ files, module include rules, repository hygiene and secrets in the staged changes.
# Activated per clone by scripts/setup-dev.sh (git config core.hooksPath .githooks). Never bypass it with --no-verify.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

status=0
scripts/check-format.sh --staged || status=1
scripts/check-architecture.sh || status=1
scripts/check-repo.sh --staged || status=1
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --pre-commit --staged --no-banner --redact . || status=1
else
    echo "pre-commit: gitleaks is not installed, so staged changes cannot be scanned for secrets (see scripts/setup-dev.sh)"
    status=1
fi
exit "$status"
